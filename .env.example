# API and persistence
DATABASE_URL=sqlite:///./data/atlaslens.db
API_HOST=127.0.0.1
API_PORT=8000
APP_VERSION=0.1.0
# Use development only on a trusted local workstation. Production refuses the
# development mock and the unauthenticated operator-report API.
APP_ENV=production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker Compose database. Replace the password in your untracked .env file.
POSTGRES_DB=atlaslens
POSTGRES_USER=atlaslens
POSTGRES_PASSWORD=
WEB_PORT=8080

# Upload and retention safety
MAX_UPLOAD_BYTES=20971520
MAX_DECODED_PIXELS=40000000
MAX_IMAGE_DIMENSION=16384
RETENTION_TTL_SECONDS=3600
KEEP_UPLOADS=false
TEMP_STORAGE_DIR=./data/tmp

# Local OCR. Installation is explicit; disabled/unverified providers degrade safely.
OCR_ENABLED=false
OCR_PROVIDER=rapidocr
RAPIDOCR_ENABLED=true
RAPIDOCR_DEVICE=cpu
RAPIDOCR_TIMEOUT_SECONDS=30
# RAPIDOCR_MODEL_ROOT defaults to %LOCALAPPDATA%\AtlasLens\models\rapidocr-3.9.1.
TESSERACT_CMD=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-sol
OPENAI_VISION_TIMEOUT_SECONDS=30
# Optional Product Phase 3C2 NVIDIA cloud vision prototype. Selecting NVIDIA and
# enabling it still cannot call the network without per-request cloud mode and
# consent. The recommended model is not an availability or production guarantee.
CLOUD_VISION_PROVIDER=openai
NVIDIA_VISION_ENABLED=false
NVIDIA_API_KEY=
NVIDIA_VISION_MODEL=qwen/qwen3.5-122b-a10b
NVIDIA_VISION_TIMEOUT_SECONDS=90
NVIDIA_VISION_MAXIMUM_IMAGE_EDGE=1280
NVIDIA_VISION_JPEG_QUALITY=82

# Local GeoCLIP provider. Artifacts are installed explicitly with `atlas models install`.
GLOBAL_MODEL_ENABLED=true
GLOBAL_MODEL_DEVICE=auto
GLOBAL_MODEL_TIMEOUT_SECONDS=120
GLOBAL_MODEL_MAX_CONCURRENCY=1
GEOCLIP_INTERNAL_TOP_K=50
# MODEL_CACHE_DIR defaults to the private per-user AtlasLens application-data directory.
# GAZETTEER_CACHE_DIR uses the same private application-data root.

# Phase 6A hybrid evidence. Segmentation is optional and never downloads at startup.
PHASE6A_ENABLED=true
SEGMENTATION_ENABLED=false
SEGMENTATION_CHECKPOINT=last_checkpoint.pt
# SEGMENTATION_MODEL_DIR defaults under the private per-user model cache.
SEGMENTATION_DEVICE=auto
SEGMENTATION_MIN_CLASS_RATIO=0.001
SEGMENTATION_MAX_DOMINANT_CLASSES=12
SEGMENTATION_TIMEOUT_SECONDS=90
GEOCLIP_CLUSTER_RADIUS_KM=40
REVERSE_GEOCODE_TOP_K=10
REVERSE_GEOCODE_TIMEOUT_SECONDS=2

# Phase 6B multi-model ensemble. Optional external providers are isolated and
# remain capability-disabled until the explicit weights-only bootstrap succeeds.
PHASE6B_ENABLED=true
OSV5M_ENABLED=true
OSV5M_WORKER_ENABLED=true
OSV5M_WORKER_HOST=127.0.0.1
OSV5M_WORKER_PORT=8791
OSV5M_WORKER_PYTHON=.local/workers/osv5m/.venv/Scripts/python.exe
OSV5M_MODEL_ID=osv5m/baseline
OSV5M_MODEL_REVISION=71548b90ac4a1aa7c37839841f411a06da82b1a6
OSV5M_DEVICE=cpu
OSV5M_TIMEOUT_SECONDS=60
PLONK_ENABLED=true
PLONK_WORKER_ENABLED=true
PLONK_WORKER_HOST=127.0.0.1
PLONK_WORKER_PORT=8792
PLONK_WORKER_PYTHON=.local/workers/plonk/.venv/Scripts/python.exe
PLONK_OSV_MODEL_ID=nicolas-dufour/PLONK_OSV_5M
PLONK_YFCC_MODEL_ID=nicolas-dufour/PLONK_YFCC
PLONK_INAT_MODEL_ID=nicolas-dufour/PLONK_iNaturalist
PLONK_DEVICE=cpu
PLONK_SAMPLE_COUNT=32
PLONK_TIMEOUT_SECONDS=90
PADDLEOCR_ENABLED=true
PADDLEOCR_WORKER_ENABLED=true
PADDLEOCR_WORKER_HOST=127.0.0.1
PADDLEOCR_WORKER_PORT=8793
PADDLEOCR_WORKER_PYTHON=.local/workers/paddleocr/.venv/Scripts/python.exe
PADDLEOCR_DEVICE=cpu
PADDLEOCR_TIMEOUT_SECONDS=45
PADDLEOCR_FALLBACK_TO_RAPIDOCR=true
OCR_PROVIDER_PRIORITY=paddleocr,rapidocr
PHASE6B_WORKER_STARTUP_TIMEOUT_SECONDS=30
GPU_MAX_HEAVY_CONCURRENCY=1
GPU_MAX_RESIDENT_MODELS=1

# Phase 6C candidate recall and bounded reference acquisition. Phase 6C remains
# off until models, workers, a leakage-attested index, and operator consent are
# ready. Startup never downloads weights or imagery.
PHASE6C_ENABLED=false
PHASE6C_PIPELINE_VERSION=phase6c-v1
PHASE6C_FUSION_CONFIG=./config/reranking/phase6c-v1.json
PHASE6C_OCR_CONFIG=./config/ocr/phase6c-v1.json
GEOCLIP_HIERARCHICAL_ENABLED=true
GEOCLIP_GLOBAL_GRID_ENABLED=true
GEOCLIP_TURKIYE_REFINEMENT_ENABLED=true
GEOCLIP_GRID_POINTS=2048
GEOCLIP_GRID_MAX_CANDIDATES=32
GEOCLIP_GRID_REFINEMENT_LEVELS_KM=900,300,90
MEGALOC_ENABLED=true
MEGALOC_WORKER_ENABLED=true
MEGALOC_WORKER_HOST=127.0.0.1
MEGALOC_WORKER_PORT=8794
MEGALOC_WORKER_PYTHON=.local/workers/megaloc/.venv/Scripts/python.exe
MEGALOC_MODEL_ROOT=.local/models/phase6c/megaloc
MEGALOC_DEVICE=auto
MEGALOC_TIMEOUT_SECONDS=60
MEGALOC_TOP_K=50
MEGALOC_PHASE3B2_CONFIG_PATH=
REFERENCE_INDEX_ENABLED=true
REFERENCE_INDEX_PATH=.local/indexes/turkiye-megaloc
REFERENCE_INDEX_MAX_IMAGES=5000
REFERENCE_INDEX_MAX_DISK_GB=2
REFERENCE_INDEX_MAX_PER_PROVINCE=100
REFERENCE_INDEX_MAX_PER_SEQUENCE=10

# Phase 3B1 rights-gated Turkiye corpus index. It is independent from Phase 6C
# and remains disabled until a compatible production descriptor/index is approved.
TURKIYE_REFERENCE_INDEX_ENABLED=false
TURKIYE_REFERENCE_INDEX_PATH=.local/indexes/turkiye-corpus-v1
TURKIYE_REFERENCE_SOURCE_POLICY_PATH=./config/corpus/source-policy-v1.json
TURKIYE_REFERENCE_DESCRIPTOR_ID=
TURKIYE_REFERENCE_DESCRIPTOR_VERSION=
TURKIYE_REFERENCE_DESCRIPTOR_DIMENSION=0
TURKIYE_REFERENCE_DESCRIPTOR_ARTIFACT_SHA256=
TURKIYE_REFERENCE_DESCRIPTOR_PREPROCESSING_VERSION=
# Phase 3B3 private pilot. Disabled by default; activation is loopback-only,
# non-production, checksum-bound, and isolated from Phase 6C.
ATLASLENS_TURKIYE_DEMO_ENABLED=false
ATLASLENS_TURKIYE_DEMO_BUNDLE_PATH=C:\AtlasLensPilot\mapillary-demo\published\demo-bundle
ATLASLENS_TURKIYE_DEMO_EXPECTED_PUBLICATION_SHA256=
ATLASLENS_TURKIYE_DEMO_EXPECTED_SOURCE_POLICY_SHA256=
ATLASLENS_TURKIYE_DEMO_EXPECTED_SELECTION_LOCK_SHA256=
ATLASLENS_TURKIYE_DEMO_TOP_K=5
ATLASLENS_TURKIYE_DEMO_UNCERTAINTY_RADIUS_M=1000
# MAPILLARY_ACCESS_TOKEN is backend-only and belongs in the untracked
# repository-root .env. Planning is offline; downloads require explicit flags.
MAPILLARY_ENABLED=false
MAPILLARY_ACCESS_TOKEN=
MAPILLARY_MAX_IMAGES=2025
MAPILLARY_IMAGE_WIDTH=1024
KARTAVIEW_ENABLED=true
KARTAVIEW_MAX_IMAGES=2500
G3_ENABLED=false
G3_DEVICE=auto
G3_MAX_CANDIDATES=96
G3_TIMEOUT_SECONDS=60
GEOLOCATION_IMPROVEMENT_MAX_ITERATIONS=8

# Optional hard-case-only cloud review. The key is backend-only. Consent is also
# required on each request; enabling this block alone cannot make a cloud call.
OPENAI_GEO_ENABLED=false
OPENAI_GEO_MODEL=gpt-5.6-luna
OPENAI_GEO_REASONING_EFFORT=none
OPENAI_GEO_IMAGE_DETAIL=low
OPENAI_GEO_MAX_OUTPUT_TOKENS=500
OPENAI_GEO_MONTHLY_BUDGET_USD=4.50
OPENAI_GEO_DAILY_CALL_LIMIT=10
OPENAI_GEO_PER_ANALYSIS_CALL_LIMIT=1
OPENAI_GEO_ALLOW_HIGH_DETAIL_RETRY=false
OPENAI_GEO_CACHE_TTL_DAYS=30
OPENAI_GEO_TIMEOUT_SECONDS=30
OPENAI_GEO_MAXIMUM_IMAGE_EDGE=768

# Phase 5C development simulation. Disabled by default. When enabled, every
# result is classified and visibly watermarked as simulated. Production startup
# rejects this setting.
ENABLE_MOCK_INFERENCE=false
MOCK_SCENARIO=development_demo
MOCK_INFERENCE_MODE=primary
# Optional contained JSON filename under services/api/dev_fixtures/inference.
MOCK_INFERENCE_FIXTURE=

# Phase 5C custom trained artifact. Registration and promotion are explicit CLI
# actions; missing/unverified artifacts remain disabled and never fabricate output.
CUSTOM_MODEL_ENABLED=true
CUSTOM_MODEL_ID=atlaslens-custom-geolocation
CUSTOM_MODEL_DEVICE=cpu

# Read-only local report catalogs. The HTTP operator surface is available only
# when APP_ENV is development/test and this explicit switch is true.
OPERATOR_API_ENABLED=false
# Defaults: %LOCALAPPDATA%\AtlasLens\reports\evaluations and ...\dataset-qa.
# EVALUATION_REPORT_DIR=C:\private\atlaslens\reports\evaluations
# DATASET_QA_REPORT_DIR=C:\private\atlaslens\reports\dataset-qa

# Phase 5B evidence retrieval. Models and licensed reference data are never
# downloaded at application startup.
PHASE5B_ENABLED=true
RETRIEVAL_ENABLED=true
RETRIEVAL_EMBEDDING_PROVIDER=siglip2-b16-384
RETRIEVAL_DEVICE=auto
RETRIEVAL_TOP_K=25
RETRIEVAL_TIMEOUT_SECONDS=20
# RETRIEVAL_INDEX_DIR defaults to the private per-user AtlasLens data directory.

# Optional bounded OSM research. Keep disabled until a contactable User-Agent and
# operator-reviewed endpoint policy are configured.
MAP_EVIDENCE_ENABLED=false
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OVERPASS_USER_AGENT=AtlasLens/0.1 map-constraints (operator-contact-required)
OVERPASS_TIMEOUT_SECONDS=5

# Abuse controls
ANALYSIS_RATE_LIMIT_PER_MINUTE=12
CLOUD_RATE_LIMIT_PER_MINUTE=3
MAX_QUEUED_JOBS=8
MAX_SSE_CONNECTIONS_PER_CLIENT=4
SSE_HEARTBEAT_SECONDS=15
MAX_SSE_LIFETIME_SECONDS=600

# Web client. Empty map style uses the OpenFreeMap Positron development default;
# production deployments must select a suitable licensed tile service.
VITE_API_BASE_URL=
VITE_DEV_API_TARGET=http://127.0.0.1:8000
VITE_DEV_PORT=5173
VITE_MAP_STYLE_URL=
VITE_MAP_PROVIDER=maplibre
# Shows local operator/provider and dataset-QA navigation only when explicitly
# enabled. The API still enforces its independent APP_ENV/OPERATOR_API_ENABLED gate.
VITE_ENABLE_OPERATOR_UI=false

# Logging
LOG_LEVEL=INFO
