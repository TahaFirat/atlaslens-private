# Optional API origin. Leave empty in development to use the Vite /api proxy.
VITE_API_BASE_URL=
# Optional MapLibre style URL. Leave empty to use the documented OpenFreeMap
# Positron development default; production must explicitly select its provider.
VITE_MAP_PROVIDER=maplibre
# Token-free development default. Production must select and review its own style/tile provider.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Development proxy target used only by Vite.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
VITE_DEV_PORT=5173
# Optional Dataset QA and System Intelligence navigation. Keep false unless the
# API is intentionally run with APP_ENV=development/test and OPERATOR_API_ENABLED=true.
VITE_ENABLE_OPERATOR_UI=false
