{
  "name": "@atlaslens/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0",
    "build": "tsc -b && vite build --configLoader runner",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check"
  },
  "dependencies": {
    "@tanstack/react-query": "5.66.8",
    "maplibre-gl": "5.3.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "16.0.0",
    "jsdom": "26.0.0",
    "openapi-typescript": "7.6.1",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
