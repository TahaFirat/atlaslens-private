{
  "schema_version": "atlaslens-turkiye-pilot-sampling-v1",
  "plan_version": "turkiye-pilot-2026-07-16-v1",
  "status": "planning_only",
  "country": {
    "iso_3166_1_alpha_2": "TR",
    "province_count": 81,
    "province_code_system": "ISO 3166-2:TR"
  },
  "source_admission": {
    "policy_path": "config/corpus/source-policy-v1.json",
    "allowed_decisions": [
      "GO",
      "GO_WITH_ATTRIBUTION",
      "FIRST_PARTY_ONLY"
    ],
    "rejected_decisions": [
      "WRITTEN_PERMISSION_REQUIRED",
      "LEGAL_REVIEW_REQUIRED",
      "RESEARCH_ONLY",
      "BLOCKED",
      "UNKNOWN"
    ],
    "rule": "A row is acquisition-ready only when source, commercial-use, and derivative/index decisions are all admitted by the current source policy and its provenance receipt is valid. FIRST_PARTY_ONLY never authorizes a third-party asset.",
    "legal_clearance_claimed": false
  },
  "assumptions": {
    "unit_system": "decimal_GB",
    "compressed_image_bytes_per_governed_asset": 750000,
    "normalized_derivative_bytes_per_governed_asset": 400000,
    "megaloc_descriptor_values_per_reference": 8448,
    "megaloc_descriptor_dtype": "float32",
    "megaloc_descriptor_bytes_per_reference": 33792,
    "metadata_bytes_per_governed_asset": 6000,
    "faiss_parquet_index_overhead_fraction_of_descriptor_bytes": 0.2,
    "staging_space_fraction_of_primary_footprint": 0.5,
    "rollback_version_space_fraction_of_primary_footprint": 0.5,
    "local_descriptor_index_and_metadata_copies": 2,
    "local_report_allowance_gb_by_option": {
      "minimal_proof": 0.05,
      "recommended_mvp": 0.1,
      "expansion": 0.25
    },
    "descriptor_generation_references_per_gpu_hour": 12000,
    "descriptor_generation_retry_factor": 1.25,
    "benchmark_configurations_per_holdout": 5,
    "evaluation_query_configuration_runs_per_gpu_hour": 240,
    "notes": [
      "Image-size assumptions are planning estimates, not measured source averages.",
      "Descriptor size is exact before ANN/index overhead: 8,448 float32 values multiplied by four bytes equals 33,792 bytes per reference.",
      "Primary cloud footprint includes governed images, normalized derivatives, reference descriptors, metadata, and FAISS/Parquet index overhead.",
      "Staging and rollback/version space are separate, non-overlapping halves of one additional primary-footprint reserve. A job that cannot build and roll back within those explicit caps must stop for a revised storage approval.",
      "Holdout queries are counted as governed image assets but never receive persistent reference descriptors.",
      "GPU throughput and evaluation throughput must be replaced by a measured pilot receipt before an Expansion authorization."
    ]
  },
